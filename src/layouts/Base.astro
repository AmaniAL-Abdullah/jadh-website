---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { ClientRouter } from "astro:transitions";
import "swiper/css";
import { GoogleTagmanager, GoogleTagmanagerNoscript } from "@digi4care/astro-google-tagmanager";

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
}
// destructure frontmatter
const { title, meta_title, description, image, noindex, canonical } = Astro.props;

// Social preview image: the page's own `image` when it sets one, otherwise the
// site-wide og-jdh.png. Always an absolute URL built from the production
// base_url (never localhost or a relative path).
const ogImagePath = image ? image : config.metadata.meta_image;
const ogImage = /^https?:\/\//.test(ogImagePath)
  ? ogImagePath
  : `${config.site.base_url.replace(/\/$/, "")}/${ogImagePath.replace(/^\//, "")}`;
---


<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    {config.google_tag_manager.enable && <GoogleTagmanager id={config.google_tag_manager.gtm_id} />}
    <!-- favicon -->
    <link rel="icon" type="image/svg+xml" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="theme-name" content="odfense-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000" />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- self-hosted fonts: preload the default weight of each -->
    <link rel="preload" href="/fonts/RHZak/ArbFONTS-RH-Zak-Reg.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/DMSans/DMSans_18pt-Regular.woff2" as="font" type="font/woff2" crossorigin />

    <!-- responsive meta -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />

    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    {canonical && <link rel="canonical" href={canonical} item-prop="url" />}

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta name="description" content={plainify(description ? description : config.metadata.meta_description)} />

    <ClientRouter />

    <!-- Scroll-reveal safety net: [data-aos] content starts hidden, so if
         JS is off (or AOS never initialises) it must show anyway. -->
    <noscript>
      <style>
        [data-aos] {
          opacity: 1 !important;
          transform: none !important;
          filter: none !important;
          clip-path: none !important;
        }
      </style>
    </noscript>

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title -->
    <meta property="og:title" content={plainify(meta_title ? meta_title : title ? title : config.site.title)} />

    <!-- og-description -->
    <meta property="og:description" content={plainify(description ? description : config.metadata.meta_description)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JADH AL OFOQ" />
    <meta property="og:url" content={`${config.site.base_url}/${Astro.url.pathname.replace("/", "")}`} />

    <!-- twitter-title -->
    <meta name="twitter:title" content={plainify(meta_title ? meta_title : title ? title : config.site.title)} />

    <!-- twitter-description -->
    <meta name="twitter:description" content={plainify(description ? description : config.metadata.meta_description)} />

    <!-- og-image -->
    <meta property="og:image" content={ogImage} />

    <!-- twitter-image -->
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {/* google tag manager noscript */}
    {config.google_tag_manager.enable && <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />}
    <TwSizeIndicator />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <script>
      import AOS from "aos";
      import "aos/dist/aos.css";

      // Scroll reveals (AOS) under Astro's ClientRouter. AOS measures every
      // element's trigger position when it (re)initialises. After a client-side
      // swap the new page has not finished laying out at that moment (fonts,
      // images, styles), so those positions are wrong and nothing below the
      // hero ever reveals until a resize -- the page looks blank. So: start AOS
      // once, then on every swap re-measure (now and again once layout settles),
      // and keep a watchdog that reveals anything visible that AOS missed.
      let started = false;
      let watch: IntersectionObserver | null = null;

      // [data-aos-min-scroll="N"] (top-center placement only): on tall screens
      // content just below a short hero is already past the trigger line at
      // load. Raise the element's offset so it still waits for N px of scroll
      // -- below-hero content reveals on scroll, never on page load.
      function holdUntilScrolled() {
        const vh = window.innerHeight;
        document.querySelectorAll<HTMLElement>("[data-aos-min-scroll]").forEach((el) => {
          const min = Number(el.dataset.aosMinScroll) || 0;
          const base = Number(el.getAttribute("data-aos-offset")) || 0;
          const target = (el.getAttribute("data-aos-anchor") &&
            document.querySelector(el.getAttribute("data-aos-anchor") as string)) as HTMLElement | null;
          const top = (target ?? el).getBoundingClientRect().top + window.scrollY;
          const needed = min - (top - vh / 2);
          if (needed > base) el.setAttribute("data-aos-offset", String(Math.ceil(needed)));
        });
      }

      // Every AOS refresh adds another scroll/resize listener, although they all
      // read AOS's single current element list. Re-measure without letting it
      // pile up a new set per navigation.
      function remeasure() {
        holdUntilScrolled();
        const add = window.addEventListener;
        window.addEventListener = function (type: string, ...rest: unknown[]) {
          if (type === "scroll" || type === "resize" || type === "orientationchange") return;
          return (add as (...a: unknown[]) => void).call(window, type, ...rest);
        } as typeof add;
        try {
          AOS.refreshHard();
        } finally {
          window.addEventListener = add;
        }
      }

      // Fail-safe: anything that has been on screen but never got revealed
      // (AOS missed it for any reason) is revealed anyway -- content must never
      // depend on the animation system. Waits a little longer when the user has
      // not scrolled yet, so below-hero content still holds for the first scroll.
      function watchVisible() {
        watch?.disconnect();
        watch = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const el = entry.target as HTMLElement;
              if (!entry.isIntersecting || el.classList.contains("aos-animate")) return;
              window.setTimeout(
                () => {
                  if (
                    el.isConnected &&
                    !el.classList.contains("aos-animate") &&
                    el.getBoundingClientRect().top < window.innerHeight * 0.6
                  ) {
                    el.classList.add("aos-animate");
                  }
                },
                window.scrollY > 40 ? 900 : 5000,
              );
            });
          },
          // Only elements already in the upper ~45% of the screen count: AOS
          // triggers at or before mid-screen, so the watchdog never races it.
          { rootMargin: "0px 0px -55% 0px" },
        );
        document.querySelectorAll("[data-aos]").forEach((el) => watch!.observe(el));
      }

      function startAos() {
        if (!started) {
          started = true;
          holdUntilScrolled();
          AOS.init({
            duration: window.innerWidth < 640 ? 600 : 700,
            once: true,
            // The router replaces the whole body; we re-measure explicitly.
            disableMutationObserver: true,
          });
        } else {
          remeasure();
        }
        watchVisible();
      }

      startAos();
      document.addEventListener("astro:after-swap", startAos);
      document.addEventListener("astro:page-load", () => {
        remeasure();
        // Layout is final a moment later (fonts, images): measure again.
        window.setTimeout(remeasure, 350);
        window.setTimeout(remeasure, 1200);
        document.fonts?.ready.then(remeasure);
      });
    </script>
    <script is:inline>
      // If AOS has not tagged anything shortly after load, reveal the content.
      setTimeout(function () {
        if (document.querySelector("[data-aos]") && !document.querySelector(".aos-init")) {
          document.documentElement.classList.add("aos-failed");
        }
      }, 2500);
    </script>
    <Footer />
  </body>
</html>
