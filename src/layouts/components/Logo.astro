---
import config from "@/config/config.json";

const { src }: { src?: string } = Astro.props;
const {
  logo,
  logo_text,
  title,
}: {
  logo: string;
  logo_text: string;
  title: string;
} = config.site;
---

<a href="/" class="navbar-brand inline-flex items-center">
  {
    src || logo ? (
      <img
        src={src ? src : logo}
        alt={title}
        class="block h-28 w-auto lg:h-36"
      />
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>
