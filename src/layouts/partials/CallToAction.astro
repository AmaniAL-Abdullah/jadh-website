---
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import Button from "@/components/Button.astro";
import SectionHeading from "@/components/SectionHeading.astro";

// unifiedHeading: homepage-only -- uses the shared section-heading system.
const { unifiedHeading = false } = Astro.props;

const sectionData = await getListPage("callToAction", "call-to-action");
if (!sectionData.data.enable) {
  return null;
}
const { title, button } = sectionData.data;
---

<!-- Flat, solid JADH-blue closing section -- no gradients/glows/lines, tall
     generous padding centers the content vertically and horizontally. -->
<section
  class:list={[
    "relative overflow-hidden bg-[#004EFF] py-16 md:py-24 lg:py-32",
    unifiedHeading && "cta--home",
  ]}
>

  <!-- Contact background video: far below the fold, so it is NOT downloaded
       with the page. The poster (first frame) shows immediately; the script
       below assigns the source shortly before the section scrolls into view
       (lighter 720p file on phones/tablets). -->
  <video
    class:list={["cta-video pointer-events-none absolute inset-0 h-full w-full object-cover", unifiedHeading && "cta-home-video"]}
    autoplay
    muted
    loop
    playsinline
    preload="none"
    poster="/images/video-posters/contact-loop.jpg"
    data-lazy-video
    data-src-desktop="/videos/contact-loop.mp4"
    data-src-mobile="/videos/contact-loop-mobile.mp4"
    aria-hidden="true"
  ></video>

  <!-- Content -->
  <div class="container relative z-10 text-center text-white">
    {
      unifiedHeading ? (
        <SectionHeading
          variant="dark"
          align="center"
          class="section-heading--cta"
          eyebrow="Let's Connect"
          ar={title.split("<br>")[0].replace(/\*\*/g, "").trim()}
          en={(title.split("<br>")[1] ?? "").replace(/\*\*/g, "").trim()}
          data-aos="fade-up-sm"
        />
      ) : (
        <h2 class="pb-4 text-white" data-aos="fade-up-sm" set:html={markdownify(title)} />
      )
    }

    {
      unifiedHeading ? (
        <p
          data-aos="fade-up-sm"
          data-aos-delay="50"
          class="mx-auto max-w-3xl pb-8 text-white/70 max-sm:max-w-none max-sm:pb-[25.6px]"
        >
          <span class="block text-[16px] leading-[1.7] max-sm:leading-[1.625] max-sm:text-balance sm:text-[18px] lg:text-[21px]">
            نسعد بتواصلكم والإجابة على استفساراتكم وتقديم حلول تدعم أعمالكم.
          </span>
          <span class="mt-[6px] block text-[14px] leading-[1.55] max-sm:mt-0 max-sm:text-[16px] max-sm:leading-[1.625] max-sm:text-balance sm:mt-1 sm:text-[16px] sm:leading-[1.6] lg:text-[19px]">
            We’re happy to connect with you and support your business needs
          </span>
        </p>
      ) : (
        <p
          data-aos="fade-up-sm"
          data-aos-delay="50"
          class="mx-auto max-w-xl text-balance pb-8 text-white/70"
        >
          نسعد بتواصلكم والإجابة على استفساراتكم وتقديم حلول تدعم أعمالكم.
          <br />
          We’re happy to connect with you and support your business needs
        </p>
      )
    }

    {
      button.enable && (
        <div
          data-aos="fade-up-sm"
          data-aos-delay="100"
          class="cta-button-wrap mx-auto block w-fit"
        >
          <Button
            href={button.link}
            label={button.label}
            variant="white"
            dir="ltr"
          />
        </div>
      )
    }
  </div>
</section>

<style is:global>
  /* Scoped to this section's own button only (via the .cta-button-wrap
     ancestor, unique to this file) -- a slightly smaller tier of the
     shared .jadh-btn--md size, and the circle/arrow moved to the trailing
     (right) edge via the Button component's own dir="ltr" prop above.
     Everything here overrides .jadh-btn--md's own rules by specificity
     (two classes vs. one), so the shared component/CSS in
     Button.astro/buttons.css is never touched and every other button on
     the site is unaffected. */
  .cta-button-wrap .jadh-btn--md {
    height: 40px;
    gap: 10px;
    padding-inline-start: 18px;
    padding-inline-end: 4px;
    font-size: 12px;
  }
  .cta-button-wrap .jadh-btn--md .jadh-btn__circle {
    width: 30px;
    height: 30px;
  }
  .cta-button-wrap .jadh-btn--md .jadh-btn__arrow {
    width: 14px;
    height: 14px;
  }
  @media (min-width: 768px) {
    .cta-button-wrap .jadh-btn--md {
      height: 46px;
      gap: 12px;
      padding-inline-start: 22px;
      padding-inline-end: 5px;
      font-size: 14px;
    }
    .cta-button-wrap .jadh-btn--md .jadh-btn__circle {
      width: 36px;
      height: 36px;
    }
    .cta-button-wrap .jadh-btn--md .jadh-btn__arrow {
      width: 16px;
      height: 16px;
    }
  }

  /* Phones only (< 640px): the dotted wave is zoomed 1.8x from the bottom so
     the dots read clearly (the video box is unchanged and clipped by the
     section), and masked to the lower part of the section so it stays under
     the copy and button. The mask is in the element's own (pre-zoom) space:
     transparent 96px / opaque 34px above the bottom = ~173px / ~61px on
     screen. */
  @media (max-width: 639.98px) {
    .cta-video {
      transform: scale(1.8);
      transform-origin: 50% 100%;
      -webkit-mask-image: linear-gradient(to bottom, transparent calc(100% - 96px), #000 calc(100% - 34px));
      mask-image: linear-gradient(to bottom, transparent calc(100% - 96px), #000 calc(100% - 34px));
    }
    /* Button: no override -- it keeps the base CTA size (40px pill, 30px
       circle), identical to the Contact page's. Same contained tap feedback. */
    .cta--home .cta-button-wrap .jadh-btn {
      overflow: hidden;
      transition:
        background-color 0.3s ease,
        box-shadow 0.3s ease,
        transform 0.2s ease;
    }
    .cta--home .cta-button-wrap .jadh-btn:active {
      transform: scale(0.98);
    }
  }
</style>

<script>
  // Lazy background video: load + play when the section is within ~one screen
  // of the viewport, pause when it is far away. Document-level listeners are
  // registered once per document (module scripts run once); only the observer
  // is rebuilt per page, so nothing is duplicated across Astro navigations.
  const SELECTOR = "video[data-lazy-video]";
  let observer: IntersectionObserver | null = null;

  const lightVideos = () => window.matchMedia("(max-width: 1023.98px)").matches;
  const reducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const play = (v: HTMLVideoElement) => {
    v.play().catch(() => {
      // Not ready yet, or paused to save power: retry once it can play.
      v.addEventListener("canplay", () => v.dataset.want === "1" && v.play().catch(() => {}), { once: true });
    });
  };

  const activate = (v: HTMLVideoElement) => {
    v.dataset.want = "1";
    if (!v.hasAttribute("src")) {
      const src = lightVideos() ? v.dataset.srcMobile : v.dataset.srcDesktop;
      if (!src) return;
      v.setAttribute("src", src);
      v.preload = "auto";
      // Resume if the browser (e.g. iOS Safari) suspends playback on its own.
      v.addEventListener("pause", () => {
        if (v.dataset.want === "1" && !v.ended && document.visibilityState === "visible") {
          v.play().catch(() => {});
        }
      });
      v.load();
    }
    if (v.paused) play(v);
  };

  const release = (v: HTMLVideoElement) => {
    v.dataset.want = "0";
    v.pause();
  };

  document.addEventListener("astro:before-swap", () => {
    observer?.disconnect();
    observer = null;
    document.querySelectorAll<HTMLVideoElement>(SELECTOR).forEach((v) => {
      v.dataset.want = "0";
      v.pause();
      v.removeAttribute("src");
      v.load();
    });
  });

  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState !== "visible") return;
    document.querySelectorAll<HTMLVideoElement>(SELECTOR).forEach((v) => {
      if (v.dataset.want === "1" && v.paused) play(v);
    });
  });

  document.addEventListener("astro:page-load", () => {
    observer?.disconnect();
    observer = null;
    const videos = document.querySelectorAll<HTMLVideoElement>(SELECTOR);
    // Reduced motion: keep the static poster, never download the video.
    if (!videos.length || reducedMotion()) return;
    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) activate(v);
          else if (v.hasAttribute("src")) release(v);
        });
      },
      { rootMargin: "100% 0px" },
    );
    videos.forEach((v) => observer!.observe(v));
  });
</script>
