    <!-- Top -->
    <div class="text-center mb-8">
      <ImageMod
        class="w-44 mx-auto mb-4"
        src="/images/logo.png"
        alt="logo"
        width={0}
        height={0}
      />

    <p class="text-sm text-text-light tracking-wide">
      <span class="block">
        حلول متكاملة للأعمال والشراكات والتشغيل
      </span>

      <span class="block mt-1">
        Integrated business solutions
      </span>
    </p>
    </div>

    <!-- Main Footer -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 py-8 border-t border-black/10">

            <!-- Contact -->
          <div class="text-center order-3 md:order-1">
