---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import CallToAction from "@/partials/CallToAction.astro";
import Button from "@/components/Button.astro";

const pageIndex = await getListPage("contact", "-index");
if (pageIndex.data.draft) {
  return Astro.redirect("/404");
}

// Same phone/email/location already published in the footer -- reused
// verbatim here rather than inventing new contact details for this page.
const contactItems = [
  {
    label: "الهاتف",
    labelEn: "Phone",
    value: "0176227083",
    href: "tel:0176227083",
  },
  {
    label: "البريد الإلكتروني",
    labelEn: "Email",
    value: "info@jadh.sa",
    href: "mailto:info@jadh.sa",
  },
  {
    label: "الموقع",
    labelEn: "Location",
    value: "الرياض، السعودية — بيشة، السعودية",
    valueEn: "Riyadh — Bisha, Saudi Arabia",
    href: "https://maps.app.goo.gl/8iFDx8a5YDew7S5J8",
  },
];
---

<Base {...pageIndex.data} title="تواصل معنا | جادة الأفق">
  <!-- Hero: compact, light, consistent with About/Services -->
  <section class="relative overflow-hidden bg-[#F6F7F9] pt-20 pb-6 md:pb-9 lg:pt-24 lg:pb-12">
    <div class="container relative z-10 text-center">
      <div class="mb-4 flex items-center justify-center gap-3" data-aos="fade-up-sm">
        <span class="h-px w-10 bg-[#034EFF]"></span>
        <span class="text-xs font-semibold uppercase tracking-[0.25em] text-muted-heading">
          Get In Touch
        </span>
        <span class="h-px w-10 bg-[#034EFF]"></span>
      </div>
      <h1
        class="text-4xl font-bold leading-tight text-black lg:text-5xl"
        data-aos="fade-up-sm"
        data-aos-delay="50"
      >
        تواصل معنا
        <span class="mt-2 block text-lg font-medium text-muted-heading lg:text-xl">Contact Us</span>
      </h1>
    </div>
  </section>

  <!-- Info + form split -->
  <section class="bg-white py-6 md:py-9 lg:py-12">
    <div class="container">
      <div class="grid gap-10 lg:grid-cols-[58%_38%] lg:gap-14" dir="rtl">
        <!-- Form card -->
        <div
          class="rounded-2xl border border-[#02005B]/8 bg-white p-6 shadow-[0_2px_24px_rgba(2,0,91,0.05)] sm:p-8 lg:p-10"
          data-aos="fade-up-sm"
          data-aos-delay="100"
        >
          <form
            action="/api/contact"
            method="POST"
            enctype="application/x-www-form-urlencoded"
            dir="rtl"
          >
            <div class="gap-6 sm:flex sm:justify-between">
              <div class="mb-6 w-full" data-aos="fade-up-sm" data-aos-delay="150">
                <label for="name" class="mb-2 block text-right text-sm font-medium text-black">
                  الأسم كامل<br /> Full Name
                </label>
                <input
                  id="name"
                  name="name"
                  class="form-input w-full border-[#D5D5D5] bg-[#F6F7F9] text-right"
                  placeholder="Name"
                  type="text"
                  required
                />
              </div>
              <div class="mb-6 w-full" data-aos="fade-up-sm" data-aos-delay="200">
                <label
                  for="mobileNumber"
                  class="mb-2 block text-right text-sm font-medium text-black"
                >
                  رقم الهاتف<br />Mobile Number
                </label>
                <input
                  id="mobileNumber"
                  name="mobileNumber"
                  class="form-input w-full border-[#D5D5D5] bg-[#F6F7F9] text-right"
                  placeholder="Phone Number"
                  type="text"
                  required
                />
              </div>
            </div>
            <div class="mb-6" data-aos="fade-up-sm" data-aos-delay="250">
              <label for="email" class="mb-2 block text-right text-sm font-medium text-black">
                البريد الإلكتروني<br /> Email Address
              </label>
              <input
                id="email"
                name="email"
                class="form-input border-[#D5D5D5] bg-[#F6F7F9] text-right"
                placeholder="Email"
                type="email"
                required
              />
            </div>
            <div class="mb-6" data-aos="fade-up-sm" data-aos-delay="300">
              <label for="message" class="mb-2 block text-right text-sm font-medium text-black">
                الرسالة<br />Messages
              </label>
              <textarea
                id="message"
                name="message"
                class="form-input border-[#D5D5D5] bg-[#F6F7F9] text-right"
                placeholder="Type your message"
                rows="4"
              ></textarea>
            </div>
            <Button
              type="submit"
              label="إرسال"
              variant="blue"
              class="w-full justify-center sm:w-auto sm:justify-start"
              data-aos="fade-up-sm"
              data-aos-delay="350"
            />
          </form>
        </div>

        <!-- Contact info -->
        <div data-aos="fade-up-sm">
          <div class="mb-6 flex items-center justify-end gap-3">
            <span class="text-xs font-semibold uppercase tracking-[0.25em] text-muted-heading">
              Contact Info
            </span>
            <span class="h-px w-10 bg-[#034EFF]"></span>
          </div>

          <div class="flex flex-col gap-6">
            {
              contactItems.map((item) => (
                <a
                  href={item.href}
                  target={item.href.startsWith("http") ? "_blank" : undefined}
                  class="group flex items-start justify-end gap-4 text-right"
                >
                  <div class="w-full">
                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-black">
                      {item.label}
                    </p>
                    {item.labelEn && (
                      <p class="text-[11px] uppercase tracking-[0.2em] text-muted-body">
                        {item.labelEn}
                      </p>
                    )}
                    <p class="mt-1.5 text-[15px] font-medium text-[#034EFF] transition-colors duration-300">
                      {item.value}
                    </p>
                    {item.valueEn && (
                      <p class="text-[13px] text-muted-body">{item.valueEn}</p>
                    )}
                  </div>
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#F6F7F9] text-[#034EFF] transition-colors duration-300 group-hover:bg-[#034EFF] group-hover:text-white">
                    {item.label === "الهاتف" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M3 5a2 2 0 0 1 2-2h3.28a1 1 0 0 1 .95.68l1.5 4.49a1 1 0 0 1-.5 1.21l-2.1 1.05a11 11 0 0 0 5.4 5.4l1.05-2.1a1 1 0 0 1 1.21-.5l4.49 1.5a1 1 0 0 1 .68.95V19a2 2 0 0 1-2 2h-1C9.72 21 3 14.28 3 6z" />
                      </svg>
                    )}
                    {item.label === "البريد الإلكتروني" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M3 7l9 6 9-6" />
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                      </svg>
                    )}
                    {item.label === "الموقع" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z" />
                        <circle cx="12" cy="10" r="2.5" />
                      </svg>
                    )}
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <CallToAction />
</Base>

<style>
  /* Scoped to this page only -- the shared .form-input class focuses to
     "secondary" (#FFFFFF, effectively invisible on a light field), so it
     needs a real focus state here without touching the global class. */
  .form-input:focus {
    border-color: #034eff;
    box-shadow: 0 0 0 3px rgba(3, 78, 255, 0.12);
  }
</style>
