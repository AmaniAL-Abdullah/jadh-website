---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";

const about = await getListPage("about", "-index");
if (about.data.draft) {
  return Astro.redirect("/404");
}
const { title, description, button, image, story, value, team, career } =
  about.data;

const careers = await getSinglePage("career");
---

<Base {...about.data}>

  <section class="relative overflow-hidden pt-[120px] pb-[120px] bg-[#f6f7f9]">
    <div class="container ">
      <div class="items-center justify-between row g-4 gy-2 xl:gy-0 flex-row-reverse">
        <div class="lg:col-6 text-right lg:pr-10">
          <h1
            class="pb-4 text-[42px] md:text-[66px] leading-[1.1]"
            data-aos="fade-up-sm"
            set:html={markdownify(title)}
          />
          <div class="text-right max-w-[700px]"
              data-aos="fade-up-sm"
              data-aos-delay="100" >
            <p class="pb-6 text-[17px] md:text-[20px]" set:html={markdownify(description)}  />
            {
              button.enable && (
                <a href={button.link} class="btn btn-primary">
                  {button.label} c
                </a>
              )
            }
          </div>
        </div>
        <!-- Desktop -->
        <img
          src="/images/jadh-ab.png"
          alt="About Image"
          class="hidden lg:block w-[470px] max-w-none lg:absolute lg:left-[80px] lg:top-1/2 -translate-y-1/2"
        />

        <!-- Mobile + Tablet -->
        <img
          src="/images/jadh-ab.png"
          alt="About Image"
          class="block lg:hidden w-[340px] md:w-[440px] mx-auto mt-6"
        />
      </div>
    </div>
  </section>


  <section class="pb-0 section">
    <div class="container">
      <div class="row g-4">
        {
          story.stats.map((s, i: number) => (
            <div
              class="sm:col-6 lg:col-4"
              data-aos="fade-right-sm"
              data-aos-delay={50 + i * 100}
            >
              <div class="h-full p-8 border border-border rounded-lg">
                <h2
                  class="pb-3 text-4xl text-center"
                  set:html={markdownify(s.value)}
                />
                <p
                  class="text-center text-text-light"
                  set:html={markdownify(s.key)}
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>


  <section class="section">
    <div class="container">
      <div class="flex flex-col lg:flex-row-reverse items-start justify-between">
        <div class="w-full lg:w-[40%] max-lg:mb-11 text-right" data-aos="fade-up-sm">
          <h2 set:html={markdownify(story.title)} />
        </div>
        <div class="w-full lg:w-[55%] text-right">
          <p
            class="pb-8"
            data-aos="fade-up-sm"
            set:html={markdownify(story.content_1)}
          />
          <p data-aos="fade-up-sm" set:html={markdownify(story.content_2)} />
        </div>
      </div>
    </div>
  </section>


  <section class="section bg-primary">
    <div class="container">
      <div class="justify-between row g-4 gy-5 flex-row-reverse">
        <div class="lg:col-4 text-right">
          <h3
            class="pb-5 text-4xl text-white"
            data-aos="fade-up-sm"
            set:html={markdownify(value.title)}
          />
          <p
            class="text-light/50"
            data-aos="fade-up-sm"
            set:html={markdownify(value.content)}
          />
        </div>
        <div class="text-white lg:col-6 text-right" dir="rtl">
          <div class="flex flex-col gap-7">
            {
              value.values.map((v, i) => (
                <div
                  class={`flex flex-col gap-5 pb-5 text-right ${
                    i !== value.values.length - 1
                      ? "border-b-2 border-border/20"
                      : ""
                  }`}
                  data-aos="fade-up-sm"
                  data-aos-delay={50 + i * 100}
                >
                  <h3
                    class="text-2xl text-white"
                    set:html={markdownify(v.title)}
                  />
                  <p class="text-light/80" set:html={markdownify(v.content)} />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

