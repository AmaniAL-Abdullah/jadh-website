---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";

const about = await getListPage("about", "-index");
if (about.data.draft) {
  return Astro.redirect("/404");
}
const { title, description, story, value } = about.data;

// Data fields on this page follow the same "Arabic <br> English" pattern
// used on the homepage -- split at render time so each language can get
// its own color, without touching the underlying content.
const splitBilingual = (s: string) => {
  const parts = (s ?? "").split("<br>");
  return { ar: (parts[0] ?? "").trim(), en: (parts[1] ?? "").trim() };
};

const aboutDescription = splitBilingual(description);
const storyTitle = splitBilingual(story.title);
const storyContent1 = splitBilingual(story.content_1);
const storyContent2 = splitBilingual(story.content_2);
const valueTitle = splitBilingual(value.title);
const valueContent = splitBilingual(value.content);
---

<Base {...about.data}>
  <!-- Hero: compact, text-only -- the page's own images (a generic 3D
       brand-orb render and an unrelated leftover stock security icon)
       don't fit a premium editorial page, so they're dropped here rather
       than kept just because they existed. -->
  <section class="relative overflow-hidden bg-[#F6F7F9] pt-16 pb-6 md:pb-9 lg:pt-20 lg:pb-12">
    <div class="container relative z-10">
      <div class="me-auto max-w-2xl text-right" dir="rtl">
        <div class="mb-3 flex items-center justify-start gap-3">
          <span class="h-px w-10 bg-[#034EFF]" data-aos="grow-line" data-aos-delay="80"></span>
          <span
            class="text-xs font-semibold uppercase tracking-[0.25em] text-muted-heading"
            data-aos="fade-right-sm"
          >
            About Jadh
          </span>
        </div>

        <h1 data-aos="fade-up-sm" data-aos-delay="50" set:html={title} />

        <p
          class="mt-6 text-[15px] leading-[1.85] lg:text-base"
          data-aos="fade-up-sm"
          data-aos-delay="100"
        >
          <span class="text-black" set:html={markdownify(aboutDescription.ar)} />
          <br />
          <span class="text-muted-body" set:html={markdownify(aboutDescription.en)} />
        </p>
      </div>
    </div>
  </section>

  <!-- Vision & Mission + the existing stats -->
  <section class="bg-white py-6 md:py-9 lg:py-12">
    <div class="container">
      <div class="mx-auto max-w-xl text-center" data-aos="fade-up-sm">
        <h2 class="text-3xl font-bold text-black lg:text-4xl">
          {storyTitle.ar}
          <span class="mt-2 block text-lg font-medium text-muted-heading lg:text-xl">
            {storyTitle.en}
          </span>
        </h2>
      </div>

      <!-- First DOM child renders on the visual right in this grid (this
           grid's dir=rtl does flip track order) -- vision first so it
           reads before mission, matching the heading's own "Vision &
           Mission" order. -->
      <div class="mx-auto mt-12 grid max-w-4xl gap-6 sm:grid-cols-2 lg:mt-16" dir="rtl">
        <div
          class="rounded-2xl border border-[#02005B]/8 bg-white p-8 text-right shadow-[0_2px_24px_rgba(2,0,91,0.05)]"
          data-aos="fade-up-sm"
        >
          <p class="text-[15px] leading-[1.85] lg:text-base">
            <span class="text-black">{storyContent1.ar}</span>
            <br />
            <span class="text-muted-body">{storyContent1.en}</span>
          </p>
        </div>
        <div
          class="rounded-2xl border border-[#02005B]/8 bg-white p-8 text-right shadow-[0_2px_24px_rgba(2,0,91,0.05)]"
          data-aos="fade-up-sm"
          data-aos-delay="100"
        >
          <p class="text-[15px] leading-[1.85] lg:text-base">
            <span class="text-black">{storyContent2.ar}</span>
            <br />
            <span class="text-muted-body">{storyContent2.en}</span>
          </p>
        </div>
      </div>

      <div class="mx-auto mt-6 grid max-w-4xl gap-5 sm:grid-cols-3" dir="rtl">
        {
          story.stats.map((s: { key: string; value: string }, i: number) => {
            const k = splitBilingual(s.key);
            return (
              <div
                class="rounded-2xl border border-[#02005B]/8 bg-[#F6F7F9] p-6 text-center"
                data-aos="fade-up-sm"
                data-aos-delay={i * 100}
              >
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-black">
                  {k.ar}
                </p>
                <p class="text-[11px] uppercase tracking-[0.2em] text-muted-body">{k.en}</p>
                <p class="mt-3 text-2xl font-bold text-[#034EFF] lg:text-3xl">{s.value}</p>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Our Goals: three cards reusing the EXACT card language already
       established on the homepage Services section (same rounded-2xl/
       border/shadow/gap values, the same hover:border-t-[#034EFF] +
       hover:bg-[#FAFBFD] accent, the same numbered font-mono index) --
       plus a restrained lift+shadow on hover, since these cards (unlike
       the service cards) have no icon/button of their own to carry the
       interaction. Tall section padding and generous heading/intro
       margins give the three cards real room to breathe. -->
  <section class="bg-white py-16 md:py-24 lg:py-32">
    <div class="container">
      <div class="mb-12 flex items-end justify-between gap-8 lg:mb-16" dir="rtl">
        <h2
          class="max-w-xl text-3xl font-bold text-black lg:text-4xl"
          data-aos="fade-up-sm"
        >
          {valueTitle.ar}
          <span class="mt-2 block text-lg font-medium text-muted-heading lg:text-xl">
            {valueTitle.en}
          </span>
        </h2>
        <span
          class="hidden h-px flex-1 bg-[#02005B]/10 md:block"
          data-aos="grow-line"
          data-aos-delay="120"
        ></span>
      </div>

      <p
        class="mb-16 max-w-2xl text-[15px] leading-[1.85] lg:mb-20"
        dir="rtl"
        data-aos="fade-up-sm"
        data-aos-delay="80"
      >
        <span class="text-black">{valueContent.ar}</span>
        <br />
        <span class="text-muted-body">{valueContent.en}</span>
      </p>

      <div class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" dir="rtl">
        {
          value.values.map((v: { title: string; content: string }, i: number) => {
            const t = splitBilingual(v.title);
            const c = splitBilingual(v.content);
            return (
              // AOS sets an inline transition-duration (the sitewide 600ms
              // default) on whatever element carries data-aos, which would
              // otherwise silently override this card's own duration-300
              // hover transition. Splitting the AOS entrance (outer, gets
              // the normal 600ms sitewide reveal) from the hover-interactive
              // card (inner, its own clean duration-300) keeps both correct
              // and independent.
              <div data-aos="fade-up-sm" data-aos-delay={i * 100}>
                <div class="group flex h-full flex-col rounded-2xl border border-[#02005B]/10 bg-white p-8 text-right shadow-[0_2px_20px_rgba(2,0,91,0.05)] transition-all duration-300 hover:-translate-y-1.5 hover:border-t-[#034EFF] hover:bg-[#FAFBFD] hover:shadow-[0_16px_36px_rgba(2,0,91,0.12)] lg:p-10">
                  <div class="mb-8 flex items-center justify-between">
                    <span data-aos="dot-pop" data-aos-delay={i * 100 + 150} class="inline-flex">
                      <span class="block h-2 w-2 rounded-full bg-[#034EFF] transition-transform duration-300 group-hover:scale-125" />
                    </span>
                    <span class="font-mono text-sm text-muted-body">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                  </div>
                  <h3 class="mb-4 text-2xl text-black">
                    <span class="text-black transition-colors duration-300 group-hover:text-[#034EFF]">
                      {t.ar}
                    </span>
                    <span class="block text-lg text-muted-heading">{t.en}</span>
                  </h3>
                  <p class="leading-[1.85]">
                    <span class="text-black">{c.ar}</span>
                    <br />
                    <span class="text-muted-body">{c.en}</span>
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <CallToAction />
</Base>
