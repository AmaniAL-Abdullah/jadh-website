---
import Base from "@/layouts/Base.astro";
---

<Base title="الصفحة غير موجودة">
  <section class="section pb-0 text-center">
    <div class="container">
      <div class="row justify-center">
        <div class="sm:col-10 md:col-8 lg:col-6">
          <span
            class="text-[8rem] block font-bold text-text-dark"
            data-aos="fade-up-sm"
          >
            404
          </span>
          <h1 class="h2 mb-4" data-aos="fade-up-sm" data-aos-delay="100">
            الصفحة غير موجودة
            <br>
            Page Not Found
          </h1>
          <div class="content" data-aos="fade-up-sm" data-aos-delay="200">
            <p>
              عذرًا، الصفحة التي تبحث عنها غير متوفرة أو تم نقلها إلى موقع آخر
              <br>
              Sorry, the page you are looking for is unavailable or has been moved
            </p>
          </div>
          <a
            href="/"
            class="btn btn-primary mt-8"
            data-aos="fade-up-sm"
            data-aos-delay="300">العودة إلى الرئيسية</a
          >
        </div>
      </div>
    </div>
  </section>
</Base>
