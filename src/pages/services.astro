---
import CustomAccordion from "@/helpers/CustomAccordion";
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import Testimonial from "@/partials/Testimonial.astro";
import { Icon } from "astro-icon/components";
import Button from "@/components/Button.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeading from "@/components/SectionHeading.astro";

const serviceIndex = await getListPage("services", "-index");
if (serviceIndex.data.draft) {
  return Astro.redirect("/404");
}
const { banner_title, description, button } = serviceIndex.data;
const testimonial = await getListPage("testimonials", "testimonial");
const services = await getSinglePage("services");
const faqs = await getListPage("faq", "faq");

// Same "Arabic <br> English" convention used across the rest of the site --
// split at render time so each language can get its own colour.
const splitBilingual = (s: string) => {
  const parts = (s ?? "").split("<br>");
  return { ar: (parts[0] ?? "").trim(), en: (parts[1] ?? "").trim() };
};
const heroTitle = splitBilingual(banner_title);
const heroDescription = splitBilingual(description);
const reviewTitle = splitBilingual(testimonial.data.homepage_title);
const reviewContent = splitBilingual(testimonial.data.content);

// Below-hero reveal (stage 2): each service row is its own "chapter" and
// starts only once its top has scrolled into the upper ~60% of the screen, so
// the first row stays still while the hero is being read. The panel leads
// (0ms) and the text follows ~100ms later. Same motion as the About page.
const rowReveal = (i: number, delay: number) => ({
  "data-aos-anchor": `#svc-row-${i}`,
  "data-aos-anchor-placement": "top-center",
  "data-aos-offset": "-100",
  "data-aos-min-scroll": "56",
  "data-aos-duration": "700",
  "data-aos-delay": String(delay),
});
---

<Base {...serviceIndex.data} title="خدماتنا | جادة الأفق">
  <!-- Hero: text-only -- the decorative overlapping dotted-circle icon
       cluster that used to sit on the left has been removed entirely (not
       just hidden), so the content block now anchors to the end (right,
       same me-auto/max-w-2xl convention used on the About/Contact heroes)
       and uses its natural width instead of leaving a gap where the
       graphic used to be. -->
  <PageHero
    eyebrow="Our Services"
    ar={heroTitle.ar}
    en={heroTitle.en}
    descAr={heroDescription.ar.replace(/<[^>]+>/g, "")}
    descEn={heroDescription.en.replace(/<[^>]+>/g, "")}
  >
    {
      button?.enable && (
        <Button
          href={button.link}
          label={button.label}
          variant="blue"
          dir="ltr"
          class="svc-btn"
          data-aos="fade-up-sm"
          data-aos-delay="200"
        />
      )
    }
  </PageHero>

  <!-- Service list: existing alternating image/text layout, restyled with
       a static blue icon in a light panel instead of the oversized
       spinning black icon in a gray-bordered box. -->
  <section class="section-y section-y--after-hero bg-white">
    <div class="container">
      <div class="mx-auto flex max-w-xl flex-col gap-20 lg:max-w-full lg:gap-24 xl:gap-28">
        {
          services.map((s, i) => {
            const t = splitBilingual(s.data.title as string);
            const c1 = splitBilingual(s.data.contact_1 as string);
            const c2 = splitBilingual(s.data.contact_2 as string);
            return (
              <div
                id={`svc-row-${i}`}
                dir="rtl"
                class="flex flex-col items-center justify-between gap-10 lg:flex-row"
              >
                <div class={`w-full text-right lg:w-[58%] ${i % 2 !== 0 ? "lg:order-2" : ""}`}>
                  <span
                    class="font-mono text-sm text-muted-body"
                    data-aos="svc-rise"
                    {...rowReveal(i, 100)}
                  >
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <h3 class="mb-6 mt-2 text-3xl font-bold leading-tight text-black lg:text-4xl">
                    <span
                      class="block text-black"
                      data-aos="svc-rise"
                      {...rowReveal(i, 150)}
                    >
                      {t.ar}
                    </span>
                    <span
                      class="mt-1 block text-xl font-medium text-muted-heading lg:text-2xl"
                      data-aos="svc-rise"
                      {...rowReveal(i, 200)}
                    >
                      {t.en}
                    </span>
                  </h3>
                  <p
                    class="mb-5 text-[15px] leading-[1.7] lg:text-base"
                    data-aos="svc-rise"
                    {...rowReveal(i, 260)}
                  >
                    <span class="text-black">{c1.ar}</span>
                    <br />
                    <span class="text-muted-body">{c1.en}</span>
                  </p>
                  <p
                    class="mb-8 text-[15px] leading-[1.7] lg:text-base"
                    data-aos="svc-rise"
                    {...rowReveal(i, 320)}
                  >
                    <span class="text-black">{c2.ar}</span>
                    <br />
                    <span class="text-muted-body">{c2.en}</span>
                  </p>
                  {s?.data?.button?.enable && (
                    <div
                      class="inline-block"
                      data-aos="svc-rise"
                      {...rowReveal(i, 380)}
                    >
                      <Button
                        href={s.data.button.link}
                        label={s.data.button.label}
                        variant="blue"
                        dir="ltr"
                        class="svc-btn"
                      />
                    </div>
                  )}
                </div>
                <div
                  class="flex w-full justify-center lg:w-[410px] lg:shrink-0 lg:justify-end"
                  data-aos="svc-panel"
                  {...rowReveal(i, 0)}
                >
                  <div class="flex h-[280px] w-[280px] shrink-0 items-center justify-center rounded-[32px] border border-[#034EFF]/[0.06] bg-[#F8F9FC] max-sm:aspect-square max-sm:h-auto max-sm:w-[calc(100%-40px)] max-sm:max-w-[430px] md:h-[320px] md:w-[320px] lg:h-[410px] lg:w-[410px]">
                    <Icon name={s.data.image} class="spin-animation spin-animation--service h-auto w-[182px] max-sm:w-[175px] text-[#034EFF] md:w-[208px]" />
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Reviews: exact same Testimonial component + homepage data source,
       restyled to the homepage's light wrapper instead of the old black
       bg-primary band -- structurally and visually identical to the
       homepage version. -->
  {
    false && testimonial.data.enable && (
      <section class="section-y bg-[#F6F7F9]">
        <div class="container relative z-10 mx-auto max-w-[1200px]">
          <div>
            <div class="flex flex-col justify-center gap-12 lg:gap-16">
              <div>
                <SectionHeading
                  ar={reviewTitle.ar.replace(/\*\*/g, "")}
                  en={reviewTitle.en.replace(/\*\*/g, "")}
                  align="center"
                  class="section-heading--flush"
                  data-aos="fade-up-sm"
                />
                <p
                  class="mx-auto mt-5 max-w-xl text-center max-sm:text-[14px] max-sm:leading-[1.7]"
                  data-aos="fade-up-sm"
                  data-aos-delay="80"
                >
                  <span class="text-black" set:html={markdownify(reviewContent.ar)} />
                  <br />
                  <span class="text-muted-body" set:html={markdownify(reviewContent.en)} />
                </p>
              </div>

              <Testimonial testimonials={testimonial.data.testimonials.slice(0, 5)} />
            </div>
          </div>
        </div>
      </section>
    )
  }

  {faqs.data.enable && <CustomAccordion faqs={faqs.data} client:only="react" />}
  <CallToAction />
</Base>

<style is:global>
  /* Every CTA button on this page only -- the .svc-btn marker class lands
     directly on the <Button>'s own root element (it's just forwarded into
     that component's class:list), so this never touches .jadh-btn--md
     globally or any button on another page. Same reduction values already
     used for the CallToAction section's own button, for consistency. */
  .svc-btn.jadh-btn--md {
    height: 40px;
    gap: 10px;
    padding-inline-start: 18px;
    padding-inline-end: 4px;
    font-size: 12px;
  }
  .svc-btn.jadh-btn--md .jadh-btn__circle {
    width: 30px;
    height: 30px;
  }
  .svc-btn.jadh-btn--md .jadh-btn__arrow {
    width: 14px;
    height: 14px;
  }
  @media (min-width: 768px) {
    .svc-btn.jadh-btn--md {
      height: 46px;
      gap: 12px;
      padding-inline-start: 22px;
      padding-inline-end: 5px;
      font-size: 14px;
    }
    .svc-btn.jadh-btn--md .jadh-btn__circle {
      width: 36px;
      height: 36px;
    }
    .svc-btn.jadh-btn--md .jadh-btn__arrow {
      width: 16px;
      height: 16px;
    }
  }
</style>
