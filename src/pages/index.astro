---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import Testimonial from "@/partials/Testimonial.astro";
import { Icon } from "astro-icon/components";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import BlogCard from "@/components/BlogCard.astro";
import ParticleGlobe from "@/helpers/ParticleGlobe";
import ServiceSlider from "@/components/homepage/ServiceSlider.astro";
import Button from "@/components/Button.astro";

const homepage = await getListPage("homepage", "-index");
const { banner, service, feature, about } = homepage.data;
const brandLogos = [...new Set(banner.brands)].map((src) =>
  src.replace("/company-logo/", "/company-logo/trimmed/"),
);

// The about content/content_2 fields follow the site-wide "Arabic <br>
// English" convention as one plain string (no existing tags separating the
// two languages). Splitting here -- not editing the data -- lets each
// language get its own colour without changing a single word of the text.
const splitBilingual = (s: string) => {
  const parts = s.split("<br>");
  return { ar: (parts[0] ?? "").trim(), en: (parts[1] ?? "").trim() };
};
const aboutContent = splitBilingual(about.content);
const aboutContent2 = splitBilingual(about.content_2);
const serviceTitle = splitBilingual(service.title);
const featureContent = splitBilingual(feature.content);

const testimonial = await getListPage("testimonials", "testimonial");
const reviewTitle = splitBilingual(testimonial.data.homepage_title);
const reviewContent = splitBilingual(testimonial.data.content);
const postIndex = await getListPage("blog", "-index");
const { homepage_title, homepage_description } = postIndex.data;
const posts = await getSinglePage("blog");
---

<Base>
<!-- Banner: the video is the actual hero background (untouched); the
     section is sized to the viewport (min-height: 100svh, see
     .hero-gradient below) instead of stacking fixed padding, so it fills
     the screen without ever running longer than it and forcing a scroll
     before About even starts. Text + globe center as one flex group
     inside that box with a responsive gap between them, rather than a
     fixed margin, so the same markup adapts cleanly from short mobile
     viewports up to large desktop ones. -->
<section class="hero-gradient relative flex flex-col overflow-hidden pt-16 pb-10 md:pt-20 md:pb-12 lg:pt-28 lg:pb-16">
  <video
    autoplay
    muted
    loop
    playsinline
    class="absolute inset-0 z-0 h-full w-full object-cover"
  >
    <source src="/videos/hero-bgg.MP4" type="video/MP4" />
  </video>
  <div class="container relative z-10 flex flex-1 flex-col items-center justify-center">
    <div class="mx-auto max-w-xl text-center lg:max-w-2xl">
      <h1
        class="leading-[1.05] tracking-[-0.03em]"
        data-aos="fade-up-sm"
        data-aos-delay="50"
        set:html={markdownify(banner.title)}
      />

      {
        banner.content && (
          <p
            class="pt-5 text-[17px] leading-[1.9] font-medium text-white/70"
            data-aos="fade-up-sm"
            data-aos-delay="100"
            set:html={markdownify(banner.content)}
          />
        )
      }

      {
        banner.button.enable && (
          <div class="inline-block pt-6" data-aos="fade-up-sm" data-aos-delay="150">
            <Button href={banner.button.link} label={banner.button.label} variant="white" />
          </div>
        )
      }
    </div>

    <!-- Globe: a small, fully-visible floating object, not a cropped peek --
         wrapper is a true square (height == width, which is what actually
         drives the sphere's diameter in ParticleGlobe) so the whole circle
         renders with clear space on every side. Gap from the text above is
         now the parent's own responsive margin-top, not a fixed offset. -->
    <div
      data-globe-size
      class="relative z-0 mt-10 flex h-[150px] w-[150px] items-center justify-center md:mt-14 md:h-[210px] md:w-[210px] lg:mt-12 lg:h-[260px] lg:w-[260px]"
    >
      <ParticleGlobe client:only="react" />
    </div>
  </div>
</section>

<style>
  /* Hero sizing: fills the viewport without ever exceeding it (so
     scrolling only ever starts at About, never mid-hero) using
     min-height rather than a fixed height, so genuinely tall content
     still isn't cropped -- it would simply grow past 100svh instead of
     overflowing a hard cap. `svh` (small viewport height) is the
     deliberate choice over plain `vh`: on mobile, `vh` includes space the
     browser's own address bar can cover/uncover, which is exactly what
     causes a hero that "should" fit to still trigger a few extra pixels
     of scroll; `svh` accounts for that. Plain `vh` first as a fallback
     for the handful of browsers without `svh` support. flex/flex-col
     (set as Tailwind classes on the section itself) + flex-1 + justify-
     center on the inner container centers the text+globe group inside
     this box with a responsive gap, instead of fixed padding stacking up
     to a height nothing was actually checking against the viewport. */
  .hero-gradient {
  position: relative;
  min-height: calc(100svh + 80px);
  background-color: #071033;
}

  /* Dissolves the video into the About section's own background
     (#F6F7F9) -- contained inside the hero's own box (bottom: 0, never
     bled past it -- see the note above about why that matters for the
     scrollbar), but now sized and eased so the transition itself has no
     perceptible edge anywhere inside it:
       - Tall: 78-85% of the hero's own height, so the fade is already
         present well above the globe, not just a strip at the very
         bottom.
       - Eased with a smoothstep curve (11 stops following 3t^2-2t^3
         rather than a plain linear ramp), which is zero-slope at BOTH
         ends. A linear or even "ease-ish" ramp still has some minimum
         rate of change at its start/end, and that's exactly what a
         human eye reads as an edge -- smoothstep's flat tangents there
         mean there is no single point where the rate of change visibly
         picks up or stops, so nothing in the fade itself reads as a
         line, only as air gradually thickening into the page. */

</style>
<!-- Banner -->
<!-- about us -->
<section class="relative z-10 -mt-20 overflow-hidden rounded-t-[80px] bg-[#F6F7F9] pt-24 pb-6 md:pb-9 lg:pb-12">
    <!-- Desktop/XL width matches the shared .container's rhythm (max-w-[1160px],
       padding dropping to 0 at 2xl) so this composition's outer left/right
       edges line up with the Services section below -- mobile/tablet keep
       their own px-5/sm:px-10 padding against the wider base max-width,
       unaffected since viewport is already narrower than either cap there. -->
  <div class="relative z-10 mx-auto max-w-[1600px] lg:max-w-[1160px] px-5 sm:px-10 2xl:px-0">
    <!-- Mobile/tablet: image and content panel share one flush rounded-2xl
         shape (connected, no gap), same as before -- a simple grid stack.
         Desktop: both sides become absolutely positioned against this
         container (each sized/pinned to its own physical edge) instead of
         grid columns, which lets the content panel's width run past the
         44/56 split -- its right edge still pinned to the container's
         right, but its left edge extends ~56px further left than the
         split, over the image, with a large soft radius there. -->
    <div
      class="grid overflow-hidden rounded-2xl lg:relative lg:h-[500px] lg:overflow-visible xl:h-[560px]"
      data-aos="fade-up-sm"
    >
      <!-- Image: fixed on the physical left, regardless of RTL text flow --
           this is a deliberate side, not a language-direction detail. A
           short, wide block at every breakpoint (never grid-stretched into
           a tall column) keeps the crop landscape instead of portrait. Own
           overflow-hidden/rounding so it still clips/rounds once the parent
           stops doing that for it at lg. -->
      <div class="relative h-[240px] overflow-hidden rounded-2xl sm:h-80 md:h-[400px] lg:absolute lg:inset-y-0 lg:left-0 lg:h-full lg:w-[44%]">
        <img
          src={about.image}
          alt="JADH Al Ofoq office"
          class="h-full w-full object-cover"
          style="object-position: 78% 38%;"
        />
      </div>

      <!-- Content: physical right. Mobile/tablet stays flush against the
           image (no radius of its own -- the shared parent rounding above
           handles it). From lg it's pinned to the container's right edge
           but made wider than the 56% split by exactly 56px (unchanged),
           so its left edge overlaps the image by the same amount as
           before; large radius + z-10 so it paints above the photo
           there. -->
      <div class="relative z-10 flex flex-col justify-center overflow-hidden bg-white px-[30px] py-11 sm:px-12 sm:py-12 lg:absolute lg:inset-y-0 lg:right-0 lg:h-full lg:w-[calc(56%+3.5rem)] lg:rounded-[56px] lg:py-0 lg:pl-20 lg:pr-[60px]">
        <div class="relative mx-auto w-full max-w-md text-right" dir="rtl">
          <div class="mb-3 flex items-center justify-start gap-3" data-aos="fade-up-sm">
            <span class="h-px w-10 bg-[#034EFF]"></span>
            <span class="text-xs font-semibold uppercase tracking-[0.25em] text-muted-heading">
              About Jadh
            </span>
          </div>

          <h2
            class="text-[26px] font-bold leading-tight text-black md:text-[32px] lg:text-[36px] xl:text-[40px] [&_strong]:font-bold [&_strong]:text-muted-heading"
            data-aos="fade-up-sm"
            data-aos-delay="50"
            set:html={markdownify(about.title)}
          />

          <p
            class="mt-4 text-[14px] leading-[1.55] md:text-[15px] xl:leading-[1.7]"
            data-aos="fade-up-sm"
            data-aos-delay="100"
          >
            <span class="text-black" set:html={markdownify(aboutContent.ar)} />
            <br />
            <span class="text-muted-body" set:html={markdownify(aboutContent.en)} />
          </p>

          <p
            class="mt-2 text-[14px] leading-[1.55] md:text-[15px] xl:leading-[1.7]"
            data-aos="fade-up-sm"
            data-aos-delay="150"
          >
            <span class="text-black" set:html={markdownify(aboutContent2.ar)} />
            <br />
            <span class="text-muted-body" set:html={markdownify(aboutContent2.en)} />
          </p>

          {about.button.enable && (
            <div class="mt-4 inline-block xl:mt-6" data-aos="fade-up-sm" data-aos-delay="200">
              <Button
                href={about.button.link}
                label={about.button.label}
                variant="blue"
                size="sm-lg"
                dir="ltr"
              />
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
<!-- about us -->


  <!-- service -->
  <section class="bg-white py-6 md:py-9 lg:py-12">
    <div class="container">
      <div class="mb-12 flex items-end justify-between gap-8 lg:mb-14" dir="rtl">
        <h2 class="max-w-2xl text-black lg:max-w-3xl" data-aos="fade-up-sm">
          <span class="block text-[26px] font-bold leading-tight text-black md:whitespace-nowrap md:text-[34px] lg:text-[42px]">
            {serviceTitle.ar}
          </span>
          <span class="mt-2 block text-lg font-medium text-muted-heading md:text-xl lg:text-2xl">
            {serviceTitle.en}
          </span>
        </h2>
      </div>
      <div class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" dir="rtl">
        {
          service.services.map((s, i: number) => {
            const t = splitBilingual(s.title);
            const c = splitBilingual(s.content);
            return (
              <div
                class="group rounded-2xl border border-[#02005B]/10 bg-white p-7 text-right shadow-[0_2px_20px_rgba(2,0,91,0.05)] transition-all duration-300 hover:border-t-[#034EFF] hover:bg-[#FAFBFD] lg:p-8"
                data-aos="fade-up-sm"
                data-aos-delay={i * 100}
              >
                <div class="mb-7 flex items-center justify-between">
                  <Icon
                    name={s.image}
                    class="h-12 w-12 text-[#034EFF] transition-transform duration-300 group-hover:scale-105"
                  />
                  <span class="font-mono text-sm text-muted-body">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                </div>
                <h3 class="mb-4 max-sm:text-[21px] text-[28px] font-bold leading-tight text-black">
                  <span class="text-black transition-colors duration-300 group-hover:text-[#034EFF]">
                    {t.ar}
                  </span>
                  <span class="block text-xl font-medium text-muted-heading">{t.en}</span>
                </h3>
                <p class="mb-6 text-base leading-[1.75]">
                  <span class="text-black">{c.ar}</span>
                  <br />
                  <span class="text-muted-body">{c.en}</span>
                </p>
                {s.button.enable && (
                  <a
                    href={s.button.link}
                    class="inline-flex items-center gap-1 text-[16px] font-medium text-[#034EFF] transition duration-300"
                  >
                    معرفة المزيد <span class="sr-only">Details</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="rtl:rotate-180"
                    >
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M5 12l14 0" />
                      <path d="M13 18l6 -6" />
                      <path d="M13 6l6 6" />
                    </svg>
                  </a>
                )}
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
  <!-- service -->

  <!-- feature -->

  <section class="bg-white py-6 md:py-9 lg:py-12">
    <div class="container">
      <div class="justify-center mb-8 row lg:mb-10">
        <div class="lg:col-8">
          <h2
            class="text-center mb-4 text-black [&_strong]:font-bold [&_strong]:text-muted-heading [&_strong]:opacity-100"
            data-aos="fade-up-sm"
            set:html={markdownify(feature.title)}
          />
        </div>
        <div class="lg:col-6">
          <p class="text-center" data-aos="fade-up-sm">
            <span class="text-black" set:html={markdownify(featureContent.ar)} />
            <br />
            <span class="text-muted-body" set:html={markdownify(featureContent.en)} />
          </p>
        </div>
      </div>
      <div
        class="flex flex-col-reverse gap-8 md:flex-row justify-center lg:justify-between md:items-stretch"
      >
        <ServiceSlider feature={feature.features} />
      </div>
    </div>
  </section>
  <!-- feature -->

  <!-- review -->
  {
    testimonial.data.enable && (
      <section class="bg-[#F6F7F9] py-6 md:py-9 lg:py-12">
        <div class="container relative z-10 mx-auto max-w-[1200px]">
          <div class="pb-8 lg:pb-10">
            <div class="flex flex-col gap-10 justify-center">
              <div>
                <h2 class="text-center pb-4" data-aos="fade-up-sm">
                  <span
                    class="block text-black max-sm:text-[21px]"
                    set:html={markdownify(reviewTitle.ar)}
                  />
                  <span
                    class="block text-muted-heading max-sm:text-[15px]"
                    set:html={markdownify(reviewTitle.en)}
                  />
                </h2>
                <p
                  class="max-w-xl mx-auto text-center max-sm:text-[14px] max-sm:leading-[1.7]"
                  data-aos="fade-up-sm"
                >
                  <span class="text-black" set:html={markdownify(reviewContent.ar)} />
                  <br />
                  <span class="text-muted-body" set:html={markdownify(reviewContent.en)} />
                </p>
              </div>

              <Testimonial
                testimonials={testimonial.data.testimonials.slice(0, 5)}
              />

              {false && (
                <div class="inline-block text-center">
                  <Button href="/reviews" label="Read All Reviews" variant="blue" dir="ltr" />
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }
  <!-- review -->

  <!-- brand -->
  <section class="bg-white py-6 md:py-9 lg:py-12">
    <div class="container">
      <div class="mb-10 text-center md:mb-12">
        <p
          class="mb-2 text-xs font-semibold uppercase tracking-[0.25em] text-muted-heading"
          data-aos="fade-up-sm"
        >
          Our Partners
        </p>
        <h2 data-aos="fade-up-sm" data-aos-delay="50">
          شركاؤنا
        </h2>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-6 md:gap-x-12 md:gap-y-8">
        {
          brandLogos.map((brand) => (
            <div class="flex w-40 items-center justify-center grayscale opacity-60 transition duration-300 hover:opacity-100 hover:grayscale-0">
              <ImageMod
                src={brand}
                alt="Company Logo"
                class="max-h-14 w-auto max-w-full object-contain md:max-h-20 lg:max-h-24"
                height={96}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <!-- brand -->

  <!-- blog -->
