---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import Testimonial from "@/partials/Testimonial.astro";
import { Icon } from "astro-icon/components";
import { getListPage } from "@/lib/contentParser.astro";
import ParticleGlobe from "@/helpers/ParticleGlobe";
import ServiceSlider from "@/components/homepage/ServiceSlider.astro";
import Button from "@/components/Button.astro";
import IntroOverlay from "@/components/IntroOverlay.astro";
import SectionHeading from "@/components/SectionHeading.astro";

const homepage = await getListPage("homepage", "-index");
const { banner, service, feature, about } = homepage.data;
const brandLogos = [...new Set(banner.brands)].map((src) =>
  src.replace("/company-logo/", "/company-logo/trimmed/"),
);

// The about content/content_2 fields follow the site-wide "Arabic <br>
// English" convention as one plain string (no existing tags separating the
// two languages). Splitting here -- not editing the data -- lets each
// language get its own colour without changing a single word of the text.
const splitBilingual = (s: string) => {
  const parts = s.split("<br>");
  return { ar: (parts[0] ?? "").trim(), en: (parts[1] ?? "").trim() };
};
const plain = (v: string) => v.replace(/\*\*/g, "").trim();
const aboutTitle = splitBilingual(about.title);
const featureTitle = splitBilingual(feature.title);
const aboutContent = splitBilingual(about.content);
const aboutContent2 = splitBilingual(about.content_2);
const serviceTitle = splitBilingual(service.title);

const testimonial = await getListPage("testimonials", "testimonial");
const reviewTitle = splitBilingual(testimonial.data.homepage_title);
const reviewContent = splitBilingual(testimonial.data.content);
---

<Base>
<!-- Banner: the video is the actual hero background (untouched); the
     section is sized to the viewport (min-height: 100svh, see
     .hero-gradient below) instead of stacking fixed padding, so it fills
     the screen without ever running longer than it and forcing a scroll
     before About even starts. Text + globe center as one flex group
     inside that box with a responsive gap between them, rather than a
     fixed margin, so the same markup adapts cleanly from short mobile
     viewports up to large desktop ones. -->
<section class="hero-gradient relative flex flex-col overflow-hidden pt-16 pb-10 md:pt-20 md:pb-12 lg:pt-28 lg:pb-16">
  <!-- Two stacked videos in the exact same box. The loop sits underneath,
       preloaded and paused on its first frame; the intro plays once on top.
       When the intro ends the loop starts and the intro is hidden only after
       the loop is really producing frames, so the swap never shows a gap
       (see the script after this section). -->
  <!-- Posters are the first frame of each clip, so the Hero always has its
       real background before any video data arrives. Sources are chosen per
       device (lighter 720p files below 1024px) and assigned by script: the
       intro immediately, the loop only once the intro is ready, so the two
       never fight for bandwidth. -->
  <video
    data-hero-loop
    muted
    loop
    playsinline
    preload="metadata"
    poster="/images/video-posters/hero-loop.jpg"
    data-src-desktop="/videos/hero-loop.mp4"
    data-src-mobile="/videos/hero-loop-mobile.mp4"
    class="absolute inset-0 z-0 h-full w-full object-cover"
  ></video>
  <video
    data-hero-intro
    muted
    playsinline
    preload="auto"
    poster="/images/video-posters/hero-intro.jpg"
    data-src-desktop="/videos/hero-intro.mp4"
    data-src-mobile="/videos/hero-intro-mobile.mp4"
    class="absolute inset-0 z-0 h-full w-full object-cover"
  ></video>
  <script is:inline>
    // Start the intro download as early as possible (before the page's module
    // scripts run). The same selection also happens in the lifecycle script
    // below for client-side navigations.
    (function () {
      var v = document.querySelector("[data-hero-intro]");
      if (
        v &&
        !v.getAttribute("src") &&
        !window.__heroIntroStarted &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        v.setAttribute(
          "src",
          window.matchMedia("(max-width: 1023.98px)").matches ? v.dataset.srcMobile : v.dataset.srcDesktop,
        );
      }
    })();
  </script>
  <div class="container relative z-10 flex flex-1 flex-col items-center justify-center min-[640px]:pb-[50px] max-sm:translate-y-5">
    <div class="mx-auto max-w-xl text-center lg:max-w-2xl">
      <!-- Eyebrow + dot reveal together as one element. -->
      <div
        class="hero-reveal mb-[16px] flex items-center justify-center gap-2.5 max-sm:mb-[22px]"
        style="--hero-reveal-delay: 0ms"
      >
        <span class="text-xs font-semibold uppercase tracking-[0.28em] text-white/70 max-sm:text-[12px] md:text-[13px]">
          JADH AL OFOQ
        </span>
        <span class="jadh-dot" aria-hidden="true"></span>
      </div>

      <!-- Title lines are revealed individually (their classes live in the
           banner markup itself), so the h1 is not a reveal element. -->
      <h1
        class="leading-[1.05] tracking-[-0.03em]"
        set:html={markdownify(banner.title)}
      />

      {
        banner.content && (
          <p
            class="hero-reveal pt-5 text-[17px] leading-[1.9] font-medium text-white/70"
            style="--hero-reveal-delay: 250ms"
            set:html={markdownify(banner.content)}
          />
        )
      }

      {
        banner.button.enable && (
          <div class="hero-reveal inline-block pt-6" style="--hero-reveal-delay: 280ms">
            <Button href={banner.button.link} label={banner.button.label} variant="white" />
          </div>
        )
      }
    </div>

    <!-- Globe: a small, fully-visible floating object, not a cropped peek --
         wrapper is a true square (height == width, which is what actually
         drives the sphere's diameter in ParticleGlobe) so the whole circle
         renders with clear space on every side. Gap from the text above is
         now the parent's own responsive margin-top, not a fixed offset. -->
    <div
      data-globe-size
      class="relative z-0 mt-10 flex h-[150px] w-[150px] items-center justify-center md:mt-14 md:h-[210px] md:w-[210px] lg:mt-12 lg:h-[260px] lg:w-[260px]"
    >
    </div>
  </div>
</section>

<script>
  // Hero video sequence: hero-intro.mp4 plays once (Hero content hidden),
  // then hero-loop.mp4 takes over and the content is revealed. The intro's
  // native `ended` event is the only trigger -- no timeouts guess its length.
  //
  // Navigation lifecycle (Astro ClientRouter): the homepage's <video>
  // elements are created by the router's swap, and a video that was
  // inserted that way never starts its resource selection ("no supported
  // sources" on the first play()). So after any swap we call load() on the
  // fresh elements, and before leaving the page we release the old ones
  // (pause + drop src) so nothing keeps decoding in the background.
  const win = window as Window & { __heroIntroStarted?: boolean };
  const heroVideos = () =>
    document.querySelectorAll<HTMLVideoElement>("[data-hero-loop], [data-hero-intro]");

  let cameFromSwap = false;

  // Module scripts run once per document, so these are registered exactly
  // once -- never per page visit.
  document.addEventListener("astro:before-swap", () => {
    heroVideos().forEach((v) => {
      v.dataset.wantPlay = "0";
      v.removeAttribute("src");
      v.pause();
      v.load();
    });
  });
  document.addEventListener("astro:after-swap", () => {
    cameFromSwap = true;
  });
  document.addEventListener("visibilitychange", () => {
    const loop = document.querySelector<HTMLVideoElement>("[data-hero-loop]");
    if (loop && document.visibilityState === "visible" && loop.dataset.wantPlay === "1" && loop.paused) {
      loop.play().catch(() => {});
    }
  });

  document.addEventListener("astro:page-load", () => {
    const loop = document.querySelector<HTMLVideoElement>("[data-hero-loop]");
    const intro = document.querySelector<HTMLVideoElement>("[data-hero-intro]");
    const content = document.querySelectorAll<HTMLElement>(".hero-reveal");
    const swapped = cameFromSwap;
    cameFromSwap = false;
    if (!loop || !intro) {
      content.forEach((el) => el.classList.add("is-in", "is-instant"));
      return;
    }

    // Pick the right file for this device. The intro normally already has its
    // src (assigned inline, before the page scripts); after a client-side swap
    // (or if that inline step did not run) assign it here and start loading.
    const lightVideos = window.matchMedia("(max-width: 1023.98px)").matches;
    const sourceFor = (v: HTMLVideoElement) =>
      (lightVideos ? v.dataset.srcMobile : v.dataset.srcDesktop) ?? "";

    // The loop gets its src only once the intro is ready (or needed), so the
    // two clips never compete for bandwidth while the page is loading.
    const ensureLoopSrc = () => {
      if (loop.hasAttribute("src")) return;
      loop.setAttribute("src", sourceFor(loop));
      loop.preload = "auto";
      loop.load();
    };

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let revealed = false;
    let loopActivated = false;
    const wantLoop = (on: boolean) => {
      loop.dataset.wantPlay = on ? "1" : "0";
    };

    // Resume the loop if the browser pauses it on its own while it should
    // be playing (power saving, hidden tab), and retry once if its load fails.
    let loopRetried = false;
    loop.addEventListener("error", () => {
      if (loopRetried || !loop.hasAttribute("src")) return;
      loopRetried = true;
      loop.load();
      if (loop.dataset.wantPlay === "1") loop.play().catch(() => {});
    });
    loop.addEventListener("pause", () => {
      if (
        loop.dataset.wantPlay === "1" &&
        loop.hasAttribute("src") &&
        document.visibilityState === "visible"
      ) {
        loop.play().catch(() => {});
      }
    });

    // Start the loop; if the browser rejects the first attempt (media not
    // ready yet, or paused to save power) try again once it can play.
    const startLoop = () => {
      if (!loop.isConnected || loop.dataset.wantPlay !== "1") return;
      loop.play().catch(() => {
        loop.addEventListener(
          "canplay",
          () => {
            if (loop.dataset.wantPlay === "1" && loop.paused) loop.play().catch(() => {});
          },
          { once: true },
        );
        window.setTimeout(() => {
          if (loop.isConnected && loop.dataset.wantPlay === "1" && loop.paused) {
            loop.play().catch(() => {});
          }
        }, 700);
      });
    };

    const hideIntro = () => {
      intro.pause();
      intro.style.visibility = "hidden";
    };

    const reveal = (instant: boolean) => {
      if (revealed) return;
      revealed = true;
      content.forEach((el) => {
        if (instant) el.classList.add("is-instant");
        el.classList.add("is-in");
      });
    };

    // Loop takes over: start it, and only once it is actually rendering
    // frames hide the intro (which keeps showing its last frame until then,
    // so there is never an empty frame) and reveal the content.
    const activateLoop = () => {
      if (loopActivated || !loop.isConnected) return;
      loopActivated = true;
      ensureLoopSrc();
      wantLoop(true);

      let switched = false;
      const switchNow = () => {
        if (switched) return;
        switched = true;
        hideIntro();
        reveal(false);
      };
      const onPlaying = () => {
        if (typeof loop.requestVideoFrameCallback === "function") {
          loop.requestVideoFrameCallback(switchNow);
          // Frame callbacks don't fire for a hidden tab; don't wait on them.
          window.setTimeout(switchNow, 250);
        } else {
          switchNow();
        }
      };

      loop.addEventListener("playing", onPlaying, { once: true });
      loop.play().catch(() => {
        // First attempt refused: show the content now and keep retrying
        // the loop in the background.
        switchNow();
        startLoop();
      });
      // Never leave the content hidden if the loop is slow or broken.
      loop.addEventListener("error", switchNow, { once: true });
      window.setTimeout(switchNow, 2500);
    };

    // Reduced motion, or the intro already ran during this page load
    // (client-side navigation back to "/"): no intro, loop right away.
    if (reduceMotion || win.__heroIntroStarted) {
      hideIntro();
      reveal(true);
      // Reduced motion keeps the static poster: no loop download at all.
      if (!reduceMotion) {
        ensureLoopSrc();
        wantLoop(true);
        startLoop();
      }
      return;
    }
    win.__heroIntroStarted = true;

    // The intro only plays on the first visit and never under reduced motion,
    // so only then does it need its file.
    const introNeedsSrc = !intro.hasAttribute("src");
    if (introNeedsSrc) intro.setAttribute("src", sourceFor(intro));
    if (swapped || introNeedsSrc) intro.load();

    // Prepare the loop as soon as the intro can play through (or after a short
    // grace period), so it is ready by the time the intro ends.
    intro.addEventListener("canplaythrough", ensureLoopSrc, { once: true });
    window.setTimeout(ensureLoopSrc, 1500);

    intro.addEventListener("ended", activateLoop, { once: true });
    // If the intro cannot load or play, fall back to the loop + content.
    intro.addEventListener("error", () => {
      if (intro.hasAttribute("src")) activateLoop();
    }, { once: true });
    intro.play().catch(activateLoop);
    // The browser can pause a muted video on its own (tab/pane hidden,
    // power saving). Resume it so the intro still reaches `ended`; if it
    // refuses, fall back to the loop.
    intro.addEventListener("pause", () => {
      if (!intro.ended && !loopActivated && intro.hasAttribute("src") && intro.isConnected) {
        intro.play().catch(activateLoop);
      }
    });
    // Not a guess at the intro's length: only covers a video that never
    // starts (blocked or stalled network), so content can't stay hidden.
    window.setTimeout(() => {
      if (intro.isConnected && intro.readyState < 2 && intro.currentTime === 0) activateLoop();
    }, 6000);
  });
</script>
<style is:global>
  /* Hero content reveal */
  .hero-reveal {
    opacity: 0;
    transform: translateY(12px);
  }

  .hero-reveal.is-in {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 700ms cubic-bezier(0.22, 1, 0.36, 1) var(--hero-reveal-delay, 0ms),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1) var(--hero-reveal-delay, 0ms);
  }

  .hero-reveal.is-instant {
    transition: none;
  }

  /* Fail-safe: if the reveal script never runs, the hero text still appears. */
  .hero-reveal:not(.is-in) {
    animation: heroRevealFailsafe 600ms ease 8s forwards;
  }
  @keyframes heroRevealFailsafe {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<style>
  .hero-gradient {
    position: relative;
    min-height: calc(100svh + 180px);
    background-color: #071033;
  }

  /* Mobile only (< 640px): a viewport-height hero instead of the extra
     180px, the text group placed above the video's dotted globe with clear
     space between them, and the video scaled down (anchored to the bottom,
     its dark top blending into the hero background) so the globe is about
     85vw wide instead of overflowing the screen. The globe sits at roughly
     50svh, so the text group ends ~36px above it. Everything >= 640px is
     untouched. */
  @media (max-width: 639.98px) {
    .hero-gradient {
      min-height: 100svh;
      padding-top: 0;
      padding-bottom: 0;
      /* The video now ends 40px above the hero's bottom edge; this strip is
         the page colour the bottom fade already blends into, so no navy shows. */
      background-image: linear-gradient(to bottom, transparent calc(100% - 40px), #f6f7f9 calc(100% - 40px));
    }
    .hero-gradient > video {
      /* Wider than the screen by 1/0.9, so it still covers edge to edge
         once scaled down. */
      left: -6%;
      right: auto;
      width: 112%;
      max-width: none;
      /* translateY(-40px): the whole composition (this video + the text
         group below) sits 40px higher. */
      transform: translateY(-40px) scale(0.9);
      transform-origin: 50% 100%;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 16%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 16%);
    }
    .hero-gradient > .container {
      flex: none;
      justify-content: flex-start;
      /* The clamp()ed type grows a little with width, so lift the group with it.
         (-188px: 40px higher than before, moving with the video above.) */
      padding-top: calc(50svh - 188px - (100vw - 375px) * 0.45);
    }
    .hero-gradient [data-globe-size] {
      height: 0;
      margin-top: 0;
    }
  }

  .hero-gradient::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 32%;
    z-index: 1;
    pointer-events: none;

    background: linear-gradient(
      to bottom,
      rgba(246, 247, 249, 0) 0%,
      rgba(246, 247, 249, 0.08) 25%,
      rgba(246, 247, 249, 0.28) 50%,
      rgba(246, 247, 249, 0.65) 75%,
      #F6F7F9 100%
    );
  }

  /* Mobile: the video sits 40px higher, so its bottom fade moves up with it
     (the strip below is the page colour the fade ends on). */
  @media (max-width: 639.98px) {
    .hero-gradient::after {
      inset: auto 0 40px 0;
    }
  }

</style>
<!-- Banner -->
<!-- about us -->
<section class="relative z-10 overflow-hidden bg-[#F6F7F9] pt-24 pb-8 max-sm:pb-[72px] md:pb-9 lg:pb-12">
    <!-- Desktop/XL width matches the shared .container's rhythm (max-w-[1160px],
       padding dropping to 0 at 2xl) so this composition's outer left/right
       edges line up with the Services section below -- mobile/tablet keep
       their own px-5/sm:px-10 padding against the wider base max-width,
       unaffected since viewport is already narrower than either cap there. -->
  <div class="relative z-10 mx-auto max-w-[1600px] lg:max-w-[1160px] px-5 sm:px-10 2xl:px-0">
    <!-- Mobile/tablet: image and content panel share one flush rounded-2xl
         shape (connected, no gap), same as before -- a simple grid stack.
         Desktop: both sides become absolutely positioned against this
         container (each sized/pinned to its own physical edge) instead of
         grid columns, which lets the content panel's width run past the
         44/56 split -- its right edge still pinned to the container's
         right, but its left edge extends ~56px further left than the
         split, over the image, with a large soft radius there. -->
    <div
      class="grid overflow-hidden rounded-2xl lg:relative lg:h-[500px] lg:overflow-visible xl:h-[560px]"
      data-aos="fade-up-sm"
    >
      <!-- Image: fixed on the physical left, regardless of RTL text flow --
           this is a deliberate side, not a language-direction detail. A
           short, wide block at every breakpoint (never grid-stretched into
           a tall column) keeps the crop landscape instead of portrait. Own
           overflow-hidden/rounding so it still clips/rounds once the parent
           stops doing that for it at lg. -->
      <div class="relative h-[240px] overflow-hidden rounded-2xl sm:h-80 md:h-[400px] lg:absolute lg:inset-y-0 lg:left-0 lg:h-full lg:w-[44%]">
        <img
          src={about.image}
          alt="JADH Al Ofoq office"
          class="h-full w-full object-cover"
          style="object-position: 78% 38%;"
        />
      </div>

      <!-- Content: physical right. Mobile/tablet stays flush against the
           image (no radius of its own -- the shared parent rounding above
           handles it). From lg it's pinned to the container's right edge
           but made wider than the 56% split by exactly 56px (unchanged),
           so its left edge overlaps the image by the same amount as
           before; large radius + z-10 so it paints above the photo
           there. -->
      <div class="relative z-10 flex flex-col justify-center overflow-hidden bg-white px-[30px] py-11 sm:px-12 sm:py-12 lg:absolute lg:inset-y-0 lg:right-0 lg:h-full lg:w-[calc(56%+3.5rem)] lg:rounded-[56px] lg:py-0 lg:pl-20 lg:pr-[60px]">
        <div class="relative mx-auto w-full max-w-md text-right" dir="rtl">
          <SectionHeading
            eyebrow="About Jadh"
            ar={plain(aboutTitle.ar)}
            en={plain(aboutTitle.en)}
            align="right"
            class="section-heading--compact"
            data-aos="fade-up-sm"
          />

          <p
            class="text-[14px] leading-[1.55] md:text-[15px] xl:leading-[1.7]"
            data-aos="fade-up-sm"
            data-aos-delay="100"
          >
            <span class="text-black" set:html={markdownify(aboutContent.ar)} />
            <br />
            <span class="text-muted-body" set:html={markdownify(aboutContent.en)} />
          </p>

          <p
            class="mt-2 text-[14px] leading-[1.55] md:text-[15px] xl:leading-[1.7]"
            data-aos="fade-up-sm"
            data-aos-delay="150"
          >
            <span class="text-black" set:html={markdownify(aboutContent2.ar)} />
            <br />
            <span class="text-muted-body" set:html={markdownify(aboutContent2.en)} />
          </p>

          {about.button.enable && (
            <div class="mt-4 inline-block xl:mt-6" data-aos="fade-up-sm" data-aos-delay="200">
              <Button
                href={about.button.link}
                label={about.button.label}
                variant="blue"
                size="sm-lg"
                dir="ltr"
              />
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
<!-- about us -->


  <!-- service -->
  <section class="bg-white py-8 max-sm:py-[72px] md:py-9 lg:py-12">
    <div class="container">
      <SectionHeading
        eyebrow="Our Solutions"
        ar={serviceTitle.ar}
        en={serviceTitle.en}
        align="right"
        class="section-heading--long"
        data-aos="fade-up-sm"
      />
      <div class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" dir="rtl">
        {
          service.services.map((s, i: number) => {
            const t = splitBilingual(s.title);
            const c = splitBilingual(s.content);
            return (
              <div
                class="group rounded-2xl border border-[#02005B]/10 bg-white p-7 text-right shadow-[0_2px_20px_rgba(2,0,91,0.05)] transition-all duration-300 hover:border-t-[#034EFF] hover:bg-[#FAFBFD] lg:p-8"
                data-aos="fade-up-sm"
                data-aos-delay={i * 100}
              >
                <div class="mb-7 flex items-center justify-between">
                  <Icon
                    name={s.image}
                    class="h-12 w-12 text-[#034EFF] transition-transform duration-300 group-hover:scale-105"
                  />
                  <span class="font-mono text-sm text-muted-body">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                </div>
                <h3 class="mb-4 max-sm:text-[21px] text-[28px] font-bold leading-tight text-black">
                  <span class="text-black transition-colors duration-300 group-hover:text-[#034EFF]">
                    {t.ar}
                  </span>
                  <span class="block text-xl font-medium text-muted-heading">{t.en}</span>
                </h3>
                <p class="mb-6 text-base leading-[1.75]">
                  <span class="text-black">{c.ar}</span>
                  <br />
                  <span class="text-muted-body">{c.en}</span>
                </p>
                {s.button.enable && (
                  <a
                    href={s.button.link}
                    class="inline-flex items-center gap-1 text-[16px] font-medium text-[#034EFF] transition duration-300"
                  >
                    معرفة المزيد <span class="sr-only">Details</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="rtl:rotate-180"
                    >
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M5 12l14 0" />
                      <path d="M13 18l6 -6" />
                      <path d="M13 6l6 6" />
                    </svg>
                  </a>
                )}
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
  <!-- service -->

  <!-- feature -->

  <section class="bg-white py-8 max-sm:py-[72px] md:py-9 lg:py-12">
    <div class="container">
      <div class="justify-center row">
        <div class="lg:col-10">
          <SectionHeading
            eyebrow="Our Values"
            ar={plain(featureTitle.ar)}
            en={plain(featureTitle.en)}
            align="center"
            class="section-heading--long"
            data-aos="fade-up-sm"
          />
        </div>
      </div>
      <div
        class="flex flex-col-reverse gap-8 md:flex-row justify-center lg:justify-between md:items-stretch"
      >
        <ServiceSlider feature={feature.features} />
      </div>
    </div>
  </section>
  <!-- feature -->

  <!-- review -->
  {
    false && (
      <section class="bg-[#F6F7F9] py-6 md:py-9 lg:py-12">
        <div class="container relative z-10 mx-auto max-w-[1200px]">
          <div class="pb-8 lg:pb-10">
            <div class="flex flex-col gap-10 justify-center">
              <div>
                <h2 class="text-center pb-4" data-aos="fade-up-sm">
                  <span
                    class="block text-black max-sm:text-[21px]"
                    set:html={markdownify(reviewTitle.ar)}
                  />
                  <span
                    class="block text-muted-heading max-sm:text-[15px]"
                    set:html={markdownify(reviewTitle.en)}
                  />
                </h2>
                <p
                  class="max-w-xl mx-auto text-center max-sm:text-[14px] max-sm:leading-[1.7]"
                  data-aos="fade-up-sm"
                >
                  <span class="text-black" set:html={markdownify(reviewContent.ar)} />
                  <br />
                  <span class="text-muted-body" set:html={markdownify(reviewContent.en)} />
                </p>
              </div>

              <Testimonial
                testimonials={testimonial.data.testimonials.slice(0, 5)}
              />

              {false && (
                <div class="inline-block text-center">
                  <Button href="/reviews" label="Read All Reviews" variant="blue" dir="ltr" />
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }
  <!-- review -->

  <!-- brand -->
  <section class="bg-white py-8 max-sm:py-[72px] md:py-9 lg:py-12">
    <div class="container">
      <SectionHeading
        eyebrow="Our Partners"
        ar="شركاؤنا"
        en="Our Partners"
        align="center"
        data-aos="fade-up-sm"
      />

      <div
        class="flex flex-wrap items-center justify-center gap-x-8 gap-y-6 md:gap-x-12 md:gap-y-8"
        data-aos="fade-up-sm"
        data-aos-delay="100"
      >
        {
          brandLogos.map((brand) => {
            // Athar Studio (6_HQ.png): drawn ~11% smaller inside its unchanged
            // slot (a transform, so the grid is not affected) and linked to
            // its site. The link adds no visible styling.
            const isAthar = brand.endsWith("/6_HQ.png");
            const logo = (
              <ImageMod
                src={brand}
                alt={isAthar ? "Athar Studio" : "Company Logo"}
                class={`max-h-14 w-auto max-w-full object-contain md:max-h-20 lg:max-h-24${isAthar ? " scale-[0.89]" : ""}`}
                height={96}
              />
            );
            return (
              <div class="flex w-40 items-center justify-center grayscale opacity-60 transition duration-300 hover:opacity-100 hover:grayscale-0">
                {isAthar ? (
                  <a
                    href="https://athar-studios.com/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex max-w-full items-center justify-center"
                  >
                    {logo}
                  </a>
                ) : (
                  logo
                )}
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
  <!-- brand -->

  <CallToAction unifiedHeading />
</Base>
